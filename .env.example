# Postgres (локальний кластер D:\fineko_pg, або прод — окрема БД на сервері)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fineko_edits?schema=public

PORT=4700
BASE_URL=http://localhost:4700

# SSO (sso.fineko.space) — клієнт реєструється одноразово:
# POST {SSO_URL}/admin/clients  (header x-admin-key: <ADMIN_API_KEY з SSO/.env>)
# body { "name": "edits", "redirectUris": ["http://localhost:4700/auth/sso/callback", "https://edits.fineko.space/auth/sso/callback"] }
SSO_URL=http://localhost:4600
EDITS_SSO_CLIENT_ID=
EDITS_SSO_CLIENT_SECRET=

# Підпис власної сесійної cookie (не пов'язано з SSO JWT_SECRET)
SESSION_SECRET=change_me_dev_secret

# Bearer-токен для публічного ingest (POST /api/edits) і /api/agent-tools
INGEST_TOKEN=change_me_dev_token
# Bearer-токен для /api/mcp (можна той самий, що INGEST_TOKEN)
MCP_SECRET=change_me_dev_token

# AI-категоризація
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
CATEGORIZE_INTERVAL_MS=300000
CATEGORIZE_BATCH_SIZE=20
